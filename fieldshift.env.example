# FieldShift local stack — copy to fieldshift.env and adjust (never commit real credentials).
# PowerShell: Get-Content fieldshift.env | ForEach-Object { if ($_ -match '^\s*([^#][^=]+)=(.*)$') { [Environment]::SetEnvironmentVariable($matches[1].Trim(), $matches[2].Trim(), 'Process') } }
#
# If the default backend port is occupied by an older API, choose a free port for BOTH
# PORT (backend) and FIELDSHIFT_API_PORT (frontend proxy). They must match.

# MongoDB (backend only — never exposed to the browser bundle)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=fieldshift_demo

# Backend HTTP (native Node API)
PORT=5174
# FIELDSHIFT_API_HOST=127.0.0.1

# Frontend dev server proxy target (must match a live backend with current /api/health)
FIELDSHIFT_API_PORT=5174

# Optional: frontend listen port (default 5173)
# FIELDSHIFT_FRONTEND_PORT=5173

# Optional: skip backend contract check for UI-only work
# FIELDSHIFT_SKIP_BACKEND_CHECK=1